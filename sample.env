# Copy this to .env and fill in values
BACKEND_URL=http://localhost:8000
CONF_THRESHOLD=0.45
IOU_THRESHOLD=0.30
MODEL_BACKEND=pytorch
# Absolute paths are accepted; relative paths resolve from the repository root.
MODEL_PATH=models/carton_yolov8n_truck_best.pt
MODEL_NAME=carton-yolov8n-truck
MODEL_VERSION=ft-truck-v1
HIGH_DETECTION_COUNT=12
FRAGMENT_MAX_GAP_RATIO=0.04
FRAGMENT_MIN_AXIS_OVERLAP=0.60
FRAGMENT_MAX_AREA_RATIO=4.0
FRAGMENT_MAX_IOU=0.20
FRAGMENT_MIN_PAIRS=1
MIN_IMAGE_DIMENSION=200
BLUR_VARIANCE_THRESHOLD=50.0
DARK_MEAN_THRESHOLD=40.0
BRIGHT_MEAN_THRESHOLD=215.0
# Optional advisory vision review. Never changes counts or removes rule-based flags.
VISUAL_REVIEW_ENABLED=false
VISUAL_REVIEW_MODEL=gemini-3.1-flash-lite
VISUAL_REVIEW_TIMEOUT_SECONDS=12.0
# Free-tier requests may be used by Google to improve its products. Do not send
# sensitive images without approval for that data handling.
# GEMINI_API_KEY=replace-me
